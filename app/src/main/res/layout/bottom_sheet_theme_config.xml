<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A24"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#33334D" />

    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Настройка виджета"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Предпросмотр на рабочем столе:"
        android:textColor="#8A8A9E"
        android:textSize="12sp" />

    <!-- Live Preview Container with Simulated Phone Wallpaper -->
    <FrameLayout
        android:id="@+id/preview_container_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/preview_wallpaper_bg"
        android:padding="10dp">

        <!-- Dynamic Live Preview Card -->
        <FrameLayout
            android:id="@+id/preview_card_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </FrameLayout>

    <!-- Transparency Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_opacity_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Прозрачность фона:"
            android:textColor="#A0A0B0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_opacity_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekbar_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:max="100"
        android:progress="15" />

    <!-- Action Button -->
    <Button
        android:id="@+id/btn_confirm_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить на рабочий стол" />

</LinearLayout>
