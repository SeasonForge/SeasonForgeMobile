<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121420"
    android:orientation="vertical"
    android:padding="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#33334D" />

    <TextView
        android:id="@+id/tv_sheet_widget_type_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выберите формат виджета"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_sheet_widget_type_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:text="Выберите подходящий макет для вашего экрана:"
        android:textColor="#8A8A9E"
        android:textSize="11sp" />

    <!-- Card 1: Season Card -->
    <LinearLayout
        android:id="@+id/btn_select_type_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/widget_box_bg"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 "
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_title_type_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Карточка сезона"
                android:textColor="#F5C342"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badge_type_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_status_pill_bg"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="Компактный"
                android:textColor="#A0A0B0"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_desc_type_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Текущий сезон, аккуратный прогресс-бар и статус"
            android:textColor="#A0A0B0"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Card 2: Countdown Timer -->
    <LinearLayout
        android:id="@+id/btn_select_type_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/widget_box_bg"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌛ "
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_title_type_countdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Таймер отсчёта"
                android:textColor="#F5C342"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badge_type_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_status_pill_bg"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="Отсчет"
                android:textColor="#F5C342"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_desc_type_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Единая стильная плашка отсчёта: ДНИ | ЧЧ:ММ:СС"
            android:textColor="#A0A0B0"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Card 3: Combined Hybrid -->
    <LinearLayout
        android:id="@+id/btn_select_type_combined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/widget_box_bg"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔮 "
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_title_type_combined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Гибридный виджет"
                android:textColor="#F5C342"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badge_type_combined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_status_pill_bg"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="Максимум"
                android:textColor="#7C4DFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_desc_type_combined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Полная сводка текущего сезона + плашка отсчёта старта"
            android:textColor="#A0A0B0"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
