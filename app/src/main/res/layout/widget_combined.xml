<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_combined_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- Seamless Full-width Game Artwork Background -->
    <ImageView
        android:id="@+id/img_widget_art_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.40"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Top Section: Header & Current Season -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Header: Title & Status Pill -->
            <LinearLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_game_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Path of Exile 2"
                    android:textColor="#F5C342"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_status_pill_bg"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="Ранний доступ"
                    android:textColor="#A0A0B0"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Current Season Title -->
            <TextView
                android:id="@+id/tv_current_season_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Текущий сезон: 0.5.0: Return of the Ancients"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <!-- Progress Bar Layout -->
            <LinearLayout
                android:id="@+id/progress_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/pb_combined_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="27"
                    android:progressDrawable="@drawable/widget_progress_style" />

                <TextView
                    android:id="@+id/tv_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="27%"
                    android:textColor="#F5C342"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider Line -->
        <TextView
            android:id="@+id/divider_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="#2A2A3E"
            android:importantForAccessibility="no" />

        <!-- Bottom Section: Countdown & 3 Boxes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Subhead Next Season -->
            <TextView
                android:id="@+id/tv_next_season_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="⏳ ДО СТАРТА: Version 1.0 (Release)"
                android:textColor="#A0A0B0"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- 3 Equal Box Timer Layout (Days : Hours : Mins&Secs Live Chronometer) -->
            <LinearLayout
                android:id="@+id/timer_boxes_layout"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Days Box -->
                <LinearLayout
                    android:id="@+id/box_days_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_box_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="1dp">

                    <TextView
                        android:id="@+id/tv_box_days_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="144"
                        android:textColor="#F5C342"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_box_days_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ДНЕЙ"
                        android:textColor="#8A8A9E"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ViewFlipper
                    android:id="@+id/flipper_colon_1"
                    android:layout_width="8dp"
                    android:layout_height="wrap_content"
                    android:autoStart="true"
                    android:flipInterval="1000">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=":"
                        android:textColor="#F5C342"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=":"
                        android:textColor="#33F5C342"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </ViewFlipper>

                <!-- Hours Box -->
                <LinearLayout
                    android:id="@+id/box_hours_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_box_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="1dp">

                    <TextView
                        android:id="@+id/tv_box_hours_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8"
                        android:textColor="#F5C342"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_box_hours_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ЧАСОВ"
                        android:textColor="#8A8A9E"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ViewFlipper
                    android:id="@+id/flipper_colon_2"
                    android:layout_width="8dp"
                    android:layout_height="wrap_content"
                    android:autoStart="true"
                    android:flipInterval="1000">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=":"
                        android:textColor="#F5C342"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=":"
                        android:textColor="#33F5C342"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </ViewFlipper>

                <!-- Minutes Box -->
                <LinearLayout
                    android:id="@+id/box_mins_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_box_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="1dp">

                    <Chronometer
                        android:id="@+id/tv_box_mins_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#F5C342"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:countDown="true" />

                    <TextView
                        android:id="@+id/tv_box_mins_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="МИНУТ"
                        android:textColor="#8A8A9E"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Footer: Start Date & Last Updated -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_start_date_footer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="📅 Старт: 15 декабря 2026"
                    android:textColor="#8A8A9E"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tv_last_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_status_pill_bg"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="Обновлено только что"
                    android:textColor="#A0A0B0"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
